# Run this client on the GPU host with localhost, or use an SSH tunnel.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Exact tags are recorded with every run. Do not use floating "latest" tags.
OLLAMA_MODEL_27B=qwen3.5:27b
OLLAMA_MODEL_35B=qwen3.5:35b

# Optional only when a trusted reverse proxy enforces bearer authentication.
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=7200

# Optional bearer token when a trusted reverse proxy protects the endpoint.
# Self-hosted Ollama on localhost normally leaves this empty.
