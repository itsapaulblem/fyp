{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation", "diagnosis", "advice", "uncertainty"],
  "properties": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "possession_team", "visible_sequence"],
      "properties": {
        "phase": {"type": "string"},
        "possession_team": {"type": "string"},
        "visible_sequence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "priority_problem", "evidence", "consequence"],
      "properties": {
        "team": {"type": "string"},
        "priority_problem": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "consequence": {"type": "string"}
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coach_message", "practice", "success_cues"],
      "properties": {
        "coach_message": {"type": "string"},
        "practice": {"type": "string"},
        "success_cues": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "visibility_limits"],
      "properties": {
        "confidence": {"enum": ["low", "medium", "high"]},
        "visibility_limits": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

